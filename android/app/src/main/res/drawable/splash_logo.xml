<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统开屏图标（values-v31 的 windowSplashScreenAnimatedIcon）。
     路径与 icon/art.svg 同源：N 是用户敲下的键，实心块是活着的 shell 光标。
     改 logo：先改 art.svg，再把这里的 pathData / 颜色同步过来。

     两个约束写在前面，都是踩过的坑：
     1. 素材四周透明、不带底色。系统原生会把图标位裁成圆，HyperOS 等 OEM
        不裁、按方形直出——任何色板都会变成一块"方块"（第一版开屏的教训）。
     2. 系统只保证图标位内圈 2/3（192dp 圆）可见，外圈会被裁掉，所以整枚
        标记收在 0.70：谁裁都切不到笔画。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.70"
        android:scaleY="0.70">
        <path
            android:pathData="M196,292 V732"
            android:strokeColor="#EAF0FB"
            android:strokeWidth="118"
            android:strokeLineCap="round"/>
        <path
            android:pathData="M586,292 V732"
            android:strokeColor="#EAF0FB"
            android:strokeWidth="118"
            android:strokeLineCap="round"/>
        <path
            android:pathData="M271,479.7 L271,273.5 Q271,257.5 281.6,269.5 L500.4,516.3 Q511,528.3 511,544.3 L511,750.5 Q511,766.5 500.4,754.5 L281.6,507.7 Q271,495.7 271,479.7 Z"
            android:fillColor="#EAF0FB"/>
        <path
            android:pathData="M718,234 H861 A26,26 0 0 1 887,260 V764 A26,26 0 0 1 861,790 H718 A26,26 0 0 1 692,764 V260 A26,26 0 0 1 718,234 Z"
            android:fillColor="#4C8DFF"/>
    </group>
</vector>
