<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以下的开屏：品牌底 + 居中透明 logo，与 12+（values-v31 的
     splash_logo 矢量）同一观感。品牌底固定不随深浅模式变，与 v31 一致。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#101725" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash" />
    </item>
</layer-list>
